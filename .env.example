# ========================================================
# EDUVATAR AI — Environment Configuration
# ========================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback in development)
# Production: postgresql+psycopg://user:password@host:5432/eduvatar
# Development / Quickstart: sqlite:///./eduvatar.db
DATABASE_URL=sqlite:///./eduvatar.db

# Authentication / Security
JWT_SECRET=super-secret-change-in-production-eduvatar-ai-jwt-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Settings: 'demo', 'openai', 'gemini'
# If set to 'demo', the application runs completely offline with rich educational scenarios
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embeddings & Vector Search: 'demo', 'openai', 'gemini'
EMBEDDING_PROVIDER=demo
EMBEDDING_API_KEY=
VECTOR_DATABASE_URL=

# Speech Services
# STT_PROVIDER: 'browser' (client Web Speech), 'openai' (Whisper), 'demo'
STT_PROVIDER=browser
STT_API_KEY=

# TTS_PROVIDER: 'browser' (client Web Speech), 'edge', 'openai', 'demo'
TTS_PROVIDER=browser
TTS_API_KEY=

# Avatar & Video Services
# AVATAR_PROVIDER: 'canvas' (custom SVG/Canvas talking avatar with visemes), 'did', 'heygen', 'demo'
AVATAR_PROVIDER=canvas
AVATAR_API_KEY=

VIDEO_PROVIDER=demo
VIDEO_API_KEY=

# CORS & Frontend Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://eduvatar-ai.vercel.app
FRONTEND_URL=http://localhost:5173

# Document Storage (Local or S3/Blob)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
